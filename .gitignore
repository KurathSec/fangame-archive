__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt

# ==========================================
# 4. Large Data Files & Local Backups
# ==========================================
# Exclude actual data JSONs (Only tracking *.sample.json)
data/games.json
data/recent_changes.json
data/profiles.json
database/seq_to_orig_map.json
# Engine-recognition resume state: R2 owns it (Database/engine_recognition_state.json),
# synced by pipelines/sync_db_r2.py like the three above. 2.8 MB, rewritten every sweep.
data/engine_recognition_state.json

# Exclude historical JSON database backups
data/games.json.*
data/games_backup_*.json
backup_state.json
backup_state.json.bak

# ==========================================
# 5. Local Game Downloads & Screenshot Caches (R2/CDN hosted)
# ==========================================
ratings/screenshots/
games/
game/
*.zip
*.7z
*.rar

# SQL comments database seed
database/*seed_comments.sql
*.db
*.sqlite

# ==========================================
# 6. Temporary Files & System Logs
# ==========================================
temp/
scratch/
*.log
download_distribution.log
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# 7. Private Credentials & Legacy Archives
# ==========================================
.env
.env.local
.env.*
pipelines/archive/

# ==========================================
# 8. Work in Progress (local-only, not shipped)
# ==========================================
# Cover-screenshot capture. capture_cover_screenshots.py drives Wine/Xvfb/bwrap
# on the capture machine and cannot run in CI; backfill_cover_screenshots.py is
# its CI half, and cover_screenshots_ci_step.yml.local holds the deploy.yml step
# that would invoke it. Un-ignore all four together when the feature ships —
# committing the workflow step alone breaks the deploy job.
pipelines/capture_cover_screenshots.py
pipelines/backfill_cover_screenshots.py
pipelines/cover_screenshots_ci_step.yml.local
data/cover_screenshots.json
